# Claude (used first if this key is set)
ANTHROPIC_API_KEY=your_anthropic_key_here
# Required for identity-linked keys that are not scoped to one workspace
ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id_here
CLAUDE_MODEL=claude-sonnet-5

# Gemini fallback (used if Claude is missing, or set AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Optional: force one provider
# AI_PROVIDER=claude
# AI_PROVIDER=gemini

PORT=3000
